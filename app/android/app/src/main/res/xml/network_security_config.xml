<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 9+ blocks cleartext HTTP by default, which silently kills a plain
  http:// connection to a laptop on the LAN — the app just fails to connect
  with no obvious reason.

  Cleartext is allowed only for private address ranges, so a demo over Wi-Fi
  works while traffic to the public internet still requires TLS. If you deploy
  the server behind a real https:// URL, none of this applies and the whole
  file can go.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <!-- 10.0.0.0/8 -->
        <domain includeSubdomains="true">10.0.0.0</domain>
        <!-- 192.168.0.0/16 -->
        <domain includeSubdomains="true">192.168.0.0</domain>
        <!-- 172.16.0.0/12 -->
        <domain includeSubdomains="true">172.16.0.0</domain>
        <domain includeSubdomains="true">localhost</domain>
    </domain-config>
    <!-- Android matches the literal host string, so list the addresses you
         actually use. Simplest during a demo: set the base-config below to
         permit cleartext everywhere, then tighten before release. -->
    <base-config cleartextTrafficPermitted="true"/>
</network-security-config>
