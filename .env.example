# Copy to .env and fill in.  `docker compose` reads .env automatically.
# .env is gitignored — never commit a real token or key.

# Shared secret for the API. Leave empty on a trusted LAN; SET IT whenever a
# tunnel is running, because a tunnel URL is reachable by anyone on the internet.
# Generate one:
#     python -c "import secrets;print(secrets.token_urlsafe(24))"
NSL_API_KEY=sajanisgay

# Concurrent WebSocket sessions. Each holds its own MediaPipe graph (~150 MB),
# so this is a memory budget, not a CPU one.
NSL_MAX_SESSIONS=4

# Open-set rejection: a sign whose Mahalanobis distance exceeds this is
# reported `unknown` no matter how confident the softmax is. Empty uses the
# value fitted at training time (the 99th percentile of TRAINING distances).
#
# That fitted value assumes inference looks like recording did. A phone, an
# unseen signer, or a low capture fps all push distances outward, so real signs
# can be rejected. Raise this if that happens, but know the cost — measured on
# the current model:
#
#     12.18 (fitted)  1.1% of real signs rejected,  42% of nonsense caught
#     16.00           0.1%                          22%
#     17.00           0.1%                          18%
#
# `off` disables the gate: the softmax then confidently names a phrase for any
# input at all, including someone just waving.
NSL_OOD_THRESHOLD=

# Connector token for the persistent tunnel. From Cloudflare Zero Trust >
# Networks > Tunnels > (your tunnel) > Install connector — the long token in the
# generated command. `docker compose up -d` runs the connector with this, so
# without it the stack is LAN-only.
#
# The tunnel's ingress rule (dashboard side) should point at
# http://localhost:8000 — the connector shares the server container's network
# namespace, so localhost there is the server.
TUNNEL_TOKEN=

# The public hostname you gave that tunnel, WITHOUT a scheme (no https://).
# cloudflared does not need this — routing lives in the Cloudflare dashboard —
# but scripts/build_app.ps1 bakes it into the APK so the app needs no setup,
# and scripts/check_tunnel.ps1 health-checks it.
TUNNEL_HOSTNAME=
